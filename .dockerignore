# Docker build context exclusions.
#
# The Dockerfile ends with `COPY . .`, so anything not listed here is baked
# into an image layer permanently â€” visible via `docker history` / `docker save`
# even when it is absent from the final `docker run` environment.

# â”€â”€ Secrets â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Never bake these into a layer. docker-compose supplies them at runtime
# through `env_file: .env`, so the image does not need them to work.
.env
.env*
!.env.example

# â”€â”€ Runtime data â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# users.db holds PBKDF2 password hashes; both are bind-mounted at runtime.
data/
uploads/

# â”€â”€ Virtualenv â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# The image builds its own venv with `uv sync` before this COPY runs.
# Copying the host one over it lands a Windows/macOS pyvenv.cfg and
# platform-specific binaries on top of the Linux venv.
.venv/
venv/
env/

# â”€â”€ VCS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
.git/
.gitignore
.dockerignore

# â”€â”€ Python caches â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg

# â”€â”€ Tooling / test artefacts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
.pytest_cache/
.ruff_cache/
.mypy_cache/
tests/
pytest.ini

# â”€â”€ Not needed at runtime â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
Dockerfile
docker-compose.yml
README.md
*.log
.DS_Store
Thumbs.db

# starter.py is the local one-click launcher: it shells out to `uv sync` and
# starts uvicorn. In the image the venv is already built and on PATH, so the
# script is dead weight whose only effect would be to re-run uv at runtime.
starter.py

# .python-version pins 3.13.12 for local dev, but the image's base interpreter
# is 3.13.15 (both satisfy requires-python = ">=3.13"). The dependency layer
# above deliberately does not copy this file - but `COPY . .` would put it back,
# which defeats that. With UV_PYTHON_DOWNLOADS=never, any `uv run`/`uv sync`
# inside the container would then demand 3.13.12, fail to find it, be forbidden
# from fetching it, and error out.
.python-version

# -- Defensive ---------------------------------------------------------------
# None of these exist today. They are listed so that adding an editor config,
# CI workflow, coverage run or a stray database outside data/ does not silently
# bake it into an image layer.
.vscode/
.idea/
.github/
.claude/
htmlcov/
.coverage
.coverage.*
*.bak
*.bak-*
*.db
*.sqlite
*.sqlite3
