# Secrets - every .env variant, not just .env itself.
# .dockerignore already excluded *.bak*, but .gitignore did not, so a
# timestamped .env.bak-* backup was swept into a commit by `git add -A`.
# GitHub push protection rejected it. The negation keeps the template tracked.
.env
.env*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime data â€” the whole directory. users.db lives here and holds
# password hashes, so ignoring only data/vectorstore/ was not enough.
data/

# User uploads and extracted images
uploads/*
!uploads/.gitkeep

# Misc
*.log
.DS_Store
Thumbs.db

# executing-plans workspace: ledger, briefs, review packages (scratch)
.superpowers/

