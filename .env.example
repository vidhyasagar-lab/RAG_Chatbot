# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/
AZURE_OPENAI_MODEL=gpt-5.2
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Embedding model (Azure OpenAI embedding deployment name)
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Embedding-specific overrides. Leave empty to reuse the main Azure values above.
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_VERSION=

# Application Settings
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# API Authentication (leave empty to disable; set for production)
API_KEY=

# Signs session cookies. REQUIRED, with no default in the source. The value
# below is a placeholder that is explicitly REJECTED - the app will not start
# until you replace it (also rejected: empty, and anything under 16 chars).
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret

# Per-IP request budget (/api/v1/health and /static/ are exempt)
RATE_LIMIT=60/minute
RATE_LIMIT_ENABLED=true

# -- Sign-in codes by email -------------------------------------
# Plain SMTP, so any provider works. Two that need no domain of your own:
#
#   Brevo    host smtp-relay.brevo.com   port 587   300 mails/day free.
#            SMTP_USER is the login Brevo shows you, SMTP_PASSWORD is the
#            SMTP key (not your account password). Verify MAIL_FROM first.
#   Gmail    host smtp.gmail.com         port 587   ~500/day.
#            SMTP_PASSWORD must be a 16-character App Password, which needs
#            2-Step Verification on. Your normal password will not work.
#
# Leave SMTP_HOST empty and APP_ENV=development to have codes written to the
# log instead of sent — the whole flow works without a provider. Left empty
# in production, the endpoint answers 503 rather than pretend to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=
MAIL_FROM_NAME=Verity

# How long a code lasts, how soon another may be asked for, how many wrong
# guesses it survives, and a ceiling on sends per day so the endpoint cannot
# be turned into a mail cannon.
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_RESEND_SECONDS=60
LOGIN_CODE_MAX_ATTEMPTS=5
LOGIN_CODE_DAILY_CAP=200

# RAG Settings – Hybrid Chunking (token-based)
PARENT_CHUNK_TOKENS=512
PARENT_OVERLAP_TOKENS=50
CHILD_CHUNK_TOKENS=128
CHILD_OVERLAP_TOKENS=16
SEMANTIC_THRESHOLD=85

# RAG Settings – Hybrid Retrieval
TOP_K_RESULTS=12
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5

# LLM
MAX_TOKENS=2048
TEMPERATURE=0.3

# Vision (multimodal)
VISION_DETAIL=high
VISION_MAX_TOKENS=1024
# Concurrent image-description calls during ingest (higher = faster, watch rate limits)
VISION_MAX_CONCURRENCY=6

# Eval-Gated Answers
EVAL_GATING_ENABLED=true
EVAL_QUALITY_THRESHOLD=0.5
EVAL_MAX_RETRIES=1

# Langfuse Observability
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -- Paths ------------------------------------------------------
# Relational stores (users, chats, evals) live in DATA_DIR;
# the vector index lives in VECTORSTORE_DIR.
DATA_DIR=data
VECTORSTORE_DIR=data/vectorstore
UPLOAD_DIR=uploads
